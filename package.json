{
  "name": "luma",
  "version": "1.0.10",
  "description": "Luma — desktop translation app that captures screen text and translates via Gemini",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:win": "npm run build && electron-builder --win portable zip --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage zip --publish never"
  },
  "author": {
    "name": "Yi-Ho Chang",
    "url": "https://yhonebox.github.io/yh/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YHOneBox/Luma-ai-translator.git"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.luma.app",
    "productName": "Luma",
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "locales/**/*",
      "assets/**/*",
      "changelog.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Luma-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "assets/logo.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Luma-${version}-win-Portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Utility",
      "maintainer": "Luma"
    }
  }
}
